{
  "name": "tali-browser-automation",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: per-chat Safari (Technology Preview) and Chrome automation with curated safari_*/chrome_* tools, per-session windows (s:<session>:<window>), isolated page readers, element-aware screenshots.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "curated-tools.mjs",
    "windows.mjs",
    "servers.mjs",
    "reader-pool.mjs",
    "youtube-notes.mjs",
    "safari-screenshot.mjs",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check index.js && node scripts/smoke-config.mjs && node scripts/gen-tool-docs.mjs --check",
    "live:reader": "node scripts/live-reader-test.mjs",
    "live:page-read": "node scripts/live-page-read-test.mjs",
    "live:chrome-read": "node scripts/live-chrome-read-test.mjs",
    "live:youtube": "node scripts/live-youtube-test.mjs",
    "live:screenshot": "node scripts/live-screenshot-test.mjs",
    "live:windows": "node scripts/live-windows-test.mjs",
    "dump:tools": "node scripts/dump-server-tools.mjs",
    "docs": "node scripts/gen-tool-docs.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "link:../../deepseek-harness/packages/core/tools",
    "@deepseek-ai/schemastery": "link:../../deepseek-harness/vendor/schemastery",
    "@modelcontextprotocol/sdk": "1.29.0",
    "chrome-devtools-mcp": "1.9.0",
    "sharp": "0.35.3"
  }
}
