{
  "name": "tali-browser-automation",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: per-chat Safari (Technology Preview) and Chrome automation with curated safari_*/chrome_* tools, per-session windows (s:<session>:<window>), isolated page readers, element-aware screenshots; browser half renders *_get_screenshot captures inline in the chat.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "*.mjs",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "prepare": "node build.mjs",
    "check": "node --check index.js && node --test tests/*.test.mjs && node scripts/smoke-config.mjs && node scripts/gen-tool-docs.mjs --check",
    "live:reader": "node scripts/live-reader-test.mjs",
    "live:page-read": "node scripts/live-page-read-test.mjs",
    "live:chrome-read": "node scripts/live-chrome-read-test.mjs",
    "live:youtube": "node scripts/live-youtube-test.mjs",
    "live:screenshot": "node scripts/live-screenshot-test.mjs",
    "live:wait": "node scripts/live-wait-recover-test.mjs",
    "live:windows": "node scripts/live-windows-test.mjs",
    "dump:tools": "node scripts/dump-server-tools.mjs",
    "docs": "node scripts/gen-tool-docs.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-tools": "link:../../deepseek-harness/packages/core/tools",
    "@deepseek-ai/schemastery": "link:../../deepseek-harness/vendor/schemastery",
    "@modelcontextprotocol/sdk": "1.29.0",
    "chrome-devtools-mcp": "1.9.0",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-client-ui-chat": "link:../../deepseek-harness/packages/client/ui-chat",
    "@deepseek-ai/dsh-client-ui-conversation": "link:../../deepseek-harness/packages/client/ui-conversation",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-session": "link:../../deepseek-harness/packages/client/ui-session",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../deepseek-harness/packages/client/ui-slots",
    "@deepseek-ai/dsh-client-ui-tool": "link:../../deepseek-harness/packages/client/ui-tool",
    "@types/react": "~18.3.1",
    "@types/react-dom": "~18.3.7",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  }
}
