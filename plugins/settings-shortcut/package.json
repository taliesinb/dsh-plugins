{
  "name": "tali-settings-shortcut",
  "version": "0.1.0",
  "private": true,
  "description": "DSH client plugin: ⌘. (Ctrl+. off macOS) toggles the web GUI's Settings panel — a chord Safari and Chrome both hand to the page (⌘, is swallowed by Safari before the page sees it).",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "node --check index.js",
    "prepare": "node build.mjs"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../../deepseek-harness/vendor/cordis",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  }
}
