{
  "name": "dsh-tailscale-remote",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: drive the Web GUI from another device on your tailnet at https://<node>.ts.net/dsh/ \u2014 an authenticating loopback reverse proxy published with `tailscale serve`, a Tailscale-user allowlist, and a QR code carrying the access token. Needs the DSH branch fix/tailscale-mounting (document-relative Host URLs).",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "proxy.mjs",
    "state.mjs",
    "tailscale.mjs",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "check": "node --check index.js && node --check proxy.mjs && node --check state.mjs && node --check tailscale.mjs && node --test tests/*.test.mjs",
    "test": "node --test tests/*.test.mjs",
    "prepare": "node build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "link:/Users/tali/github/deepseek-harness/vendor/schemastery",
    "uqr": "^0.1.3"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:/Users/tali/github/deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-client-connection": "link:/Users/tali/github/deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-client-ui-primitives": "link:/Users/tali/github/deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:/Users/tali/github/deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-slots": "link:/Users/tali/github/deepseek-harness/packages/client/ui-slots",
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  }
}
