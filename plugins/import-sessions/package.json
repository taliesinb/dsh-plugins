{
  "name": "tali-import-sessions",
  "version": "0.1.0",
  "private": true,
  "description": "DSH plugin: /import-claude and /import-pi — import Claude Code and pi coding-agent transcripts from disk into real DSH sessions. Native file-or-folder chooser rooted at the agent's session store, a bulk tree modal (workspaces → sessions) with directory-matched DSH workspace destinations, archive vs working-session fidelity modes, written through DSH's own persistence, attachment and workspace services.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "host/*.mjs",
    "lib/client.js",
    "lib/client.js.map",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "check": "node --check index.js && for f in lib/*.mjs; do node --check $f || exit 1; done && node --test tests/*.test.mjs",
    "prepare": "node build.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "link:../../deepseek-harness/vendor/schemastery"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "link:../../deepseek-harness/vendor/cordis",
    "@deepseek-ai/dsh-api-session-controller": "link:../../deepseek-harness/packages/api/session-controller",
    "@deepseek-ai/dsh-client-connection": "link:../../deepseek-harness/packages/client/connection",
    "@deepseek-ai/dsh-client-ui-commands": "link:../../deepseek-harness/packages/client/ui-commands",
    "@deepseek-ai/dsh-client-ui-layout": "link:../../deepseek-harness/packages/client/ui-layout",
    "@deepseek-ai/dsh-client-ui-primitives": "link:../../deepseek-harness/packages/client/ui-primitives",
    "@deepseek-ai/dsh-client-ui-renderer": "link:../../deepseek-harness/packages/client/ui-renderer",
    "@deepseek-ai/dsh-client-ui-slots": "link:../../deepseek-harness/packages/client/ui-slots",
    "@types/react": "~18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.2"
  }
}
